<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset
            android:insetLeft="@dimen/nav_mini_drawer_pill_inset_horizontal"
            android:insetRight="@dimen/nav_mini_drawer_pill_inset_horizontal"
            android:insetTop="@dimen/nav_mini_drawer_pill_inset_vertical"
            android:insetBottom="@dimen/nav_mini_drawer_pill_inset_vertical">
            <shape android:shape="rectangle">
                <corners android:radius="16dp" />
                <solid android:color="?attr/colorSecondaryContainer" />
            </shape>
        </inset>
    </item>
    <item android:state_activated="true">
        <inset
            android:insetLeft="@dimen/nav_mini_drawer_pill_inset_horizontal"
            android:insetRight="@dimen/nav_mini_drawer_pill_inset_horizontal"
            android:insetTop="@dimen/nav_mini_drawer_pill_inset_vertical"
            android:insetBottom="@dimen/nav_mini_drawer_pill_inset_vertical">
            <shape android:shape="rectangle">
                <corners android:radius="16dp" />
                <solid android:color="?attr/colorSecondaryContainer" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset
            android:insetLeft="@dimen/nav_mini_drawer_pill_inset_horizontal"
            android:insetRight="@dimen/nav_mini_drawer_pill_inset_horizontal"
            android:insetTop="@dimen/nav_mini_drawer_pill_inset_vertical"
            android:insetBottom="@dimen/nav_mini_drawer_pill_inset_vertical">
            <shape android:shape="rectangle">
                <corners android:radius="16dp" />
                <solid android:color="?attr/colorSurfaceContainerHigh" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
