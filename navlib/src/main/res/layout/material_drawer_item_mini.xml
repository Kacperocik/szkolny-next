<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/mini_drawer_item_pill_bg"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/material_drawer_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        tools:src="@android:drawable/ic_menu_info_details" />

    <TextView
        android:id="@+id/material_drawer_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/nav_mini_drawer_pill_inset_horizontal"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="16dp"
        android:minHeight="16dp"
        android:padding="2dp"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="3" />
</FrameLayout>
