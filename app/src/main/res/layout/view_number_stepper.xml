<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:gravity="center_vertical"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <pl.szczodrzynski.edziennik.ui.base.views.IconicsMaterialButton
        android:id="@+id/stepperMinus"
        style="?materialIconButtonSecondaryStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/number_stepper_decrease"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="10dp"
        app:cornerRadius="18dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="16dp"
        app:iiv_color="?colorOnSecondaryContainer"
        app:iiv_icon="cmd-minus"
        app:iiv_size="16dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    <EditText
        android:id="@+id/stepperValue"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:imeOptions="actionDone"
        android:maxLines="1"
        android:textAppearance="?textAppearanceTitleMedium"
        android:textColor="?android:textColorPrimary"
        tools:text="5" />

    <pl.szczodrzynski.edziennik.ui.base.views.IconicsMaterialButton
        android:id="@+id/stepperPlus"
        style="?materialIconButtonSecondaryStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/number_stepper_increase"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="10dp"
        app:cornerRadius="18dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="16dp"
        app:iiv_color="?colorOnSecondaryContainer"
        app:iiv_icon="cmd-plus"
        app:iiv_size="16dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
</merge>
