<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:agendaCalendar="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.loadingindicator.LoadingIndicator
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        agendaCalendar:indicatorColor="?attr/colorPrimary" />

    <com.github.tibolte.agendacalendarview.AgendaCalendarView
        android:id="@+id/agenda_default_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        agendaCalendar:agendaCurrentDayTextColor="?attr/colorPrimary"
        agendaCalendar:calendarColor="?attr/colorSurfaceContainerHigh"
        agendaCalendar:calendarCurrentDayTextColor="?attr/colorPrimary"
        agendaCalendar:calendarDayTextColor="?attr/colorOnSurface"
        agendaCalendar:calendarHeaderColor="?attr/colorSurfaceContainerHigh"
        agendaCalendar:calendarHeaderTextColor="?attr/colorOnSurface"
        agendaCalendar:calendarPastDayTextColor="?attr/colorOutline"
        agendaCalendar:fabColor="?attr/colorPrimaryContainer"
        agendaCalendar:layout_constraintBottom_toBottomOf="parent"
        agendaCalendar:layout_constraintEnd_toEndOf="parent"
        agendaCalendar:layout_constraintHorizontal_bias="1.0"
        agendaCalendar:layout_constraintStart_toStartOf="parent"
        agendaCalendar:layout_constraintTop_toTopOf="parent"
        agendaCalendar:layout_constraintVertical_bias="1.0" />
</LinearLayout>
