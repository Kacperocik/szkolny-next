<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/noteItemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorCard"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.GroupSingle"
    app:strokeWidth="0dp"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/colorLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.mikepenz.iconics.view.IconicsTextView
                android:id="@+id/topic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="4"
                android:minLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?android:attr/textColorPrimary"
                tools:text="Temat notatki. Ale może też być treść tutaj." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editButton"
                style="?materialIconButtonSecondaryStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/community_material_font_v5_8_55"
                android:padding="0dp"
                android:text="\uf2f4"
                android:textSize="20sp"
                app:iconPadding="0dp"
                tools:visibility="visible" />
        </LinearLayout>

        <com.mikepenz.iconics.view.IconicsTextView
            android:id="@+id/addedBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorSecondary"
            android:textStyle="bold"
            tools:text="Jakub Szczodrzyński • 23 października" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
