<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="16dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/grades_stats_title"
        android:textAppearance="?textAppearanceTitleLarge" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/noData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/grades_stats_no_data"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/normalTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:text="@string/grades_stats_normal"
            android:textAppearance="?textAppearanceTitleMedium"
            android:textColor="?attr/colorSecondary" />

        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/helpButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerInside"
            app:iiv_color="?colorOutline"
            app:iiv_icon="cmd-help-circle-outline"
            app:iiv_size="24dp"
            tools:src="@android:drawable/ic_menu_help" />
    </LinearLayout>

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/normalLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:alignItems="stretch"
        app:flexWrap="wrap">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/normalSemester1Layout"
            style="?materialCardViewFilledStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:clickable="false"
            android:focusable="false"
            android:foreground="@null"
            app:cardBackgroundColor="?attr/colorCard"
            app:layout_flexBasisPercent="47%"
            app:layout_flexGrow="1"
            app:shapeAppearance="?shapeAppearanceCornerLarge">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="left"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/grades_stats_semester_1"
                    android:textAppearance="?textAppearanceBodyLarge"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/normalSemester1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textAppearance="?textAppearanceTitleMedium"
                    tools:text="4,56" />

                <LinearLayout
                    android:id="@+id/normalSemester1BeforeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/grades_simulator_before_change_label"
                        android:textAppearance="?textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/normalSemester1BeforeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="?textAppearanceTitleMedium"
                        tools:text="4,50" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/normalSemester1SimRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/grades_simulator_after_change_label"
                        android:textAppearance="?textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/normalSemester1SimValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="?textAppearanceTitleMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        tools:text="4,75" />
                </LinearLayout>

                <TextView
                    android:id="@+id/normalSemester1Notice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?textAppearanceBodySmall"
                    tools:text="*z ocen proponowanych" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/normalSemester2Layout"
            style="?materialCardViewFilledStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:clickable="false"
            android:focusable="false"
            android:foreground="@null"
            app:cardBackgroundColor="?attr/colorCard"
            app:layout_flexBasisPercent="47%"
            app:layout_flexGrow="1"
            app:shapeAppearance="?shapeAppearanceCornerLarge">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="left"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/grades_stats_semester_2"
                    android:textAppearance="?textAppearanceBodyLarge"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/normalSemester2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textAppearance="?textAppearanceTitleMedium"
                    tools:text="4,67" />

                <LinearLayout
                    android:id="@+id/normalSemester2BeforeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/grades_simulator_before_change_label"
                        android:textAppearance="?textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/normalSemester2BeforeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="?textAppearanceTitleMedium"
                        tools:text="4,60" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/normalSemester2SimRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/grades_simulator_after_change_label"
                        android:textAppearance="?textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/normalSemester2SimValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="?textAppearanceTitleMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        tools:text="4,67" />
                </LinearLayout>

                <TextView
                    android:id="@+id/normalSemester2Notice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?textAppearanceBodySmall"
                    tools:text="*przewidywana średnia" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/normalYearlyLayout"
            style="?materialCardViewFilledStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:foreground="@null"
            app:cardBackgroundColor="?attr/colorCard"
            app:layout_flexBasisPercent="48%"
            app:layout_flexGrow="1"
            app:shapeAppearance="?shapeAppearanceCornerLarge">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="left"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/grades_stats_yearly"
                    android:textAppearance="?textAppearanceBodyLarge"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/normalYearly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textAppearance="?textAppearanceTitleMedium"
                    tools:text="3,75" />

                <LinearLayout
                    android:id="@+id/normalYearlyBeforeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/grades_simulator_before_change_label"
                        android:textAppearance="?textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/normalYearlyBeforeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="?textAppearanceTitleMedium"
                        tools:text="3,70" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/normalYearlySimRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/grades_simulator_after_change_label"
                        android:textAppearance="?textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/normalYearlySimValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="?textAppearanceTitleMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        tools:text="3,75" />
                </LinearLayout>

                <TextView
                    android:id="@+id/normalYearlyNotice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?textAppearanceBodySmall"
                    tools:text="*przewidywana średnia" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.flexbox.FlexboxLayout>

    <View
        android:id="@+id/normalDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?colorSurface" />

    <TextView
        android:id="@+id/pointTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"
        android:text="@string/grades_stats_point"
        android:textAppearance="?textAppearanceTitleMedium" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/pointLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:alignItems="stretch"
        app:flexWrap="wrap">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pointSemester1Layout"
            style="?materialCardViewFilledStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:clickable="false"
            android:focusable="false"
            android:foreground="@null"
            app:cardBackgroundColor="?attr/colorCard"
            app:layout_flexBasisPercent="47%"
            app:layout_flexGrow="1"
            app:shapeAppearance="?shapeAppearanceCornerLarge">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="left"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/grades_stats_semester_1"
                    android:textAppearance="?textAppearanceBodyLarge"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/pointSemester1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?textAppearanceTitleMedium"
                    tools:text="95%" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pointSemester2Layout"
            style="?materialCardViewFilledStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:clickable="false"
            android:focusable="false"
            android:foreground="@null"
            app:cardBackgroundColor="?attr/colorCard"
            app:layout_flexBasisPercent="47%"
            app:layout_flexGrow="1"
            app:shapeAppearance="?shapeAppearanceCornerLarge">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="left"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/grades_stats_semester_2"
                    android:textAppearance="?textAppearanceBodyLarge"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/pointSemester2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?textAppearanceTitleMedium"
                    tools:text="93,27%" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pointYearlyLayout"
            style="?materialCardViewFilledStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:foreground="@null"
            app:cardBackgroundColor="?attr/colorCard"
            app:layout_flexBasisPercent="48%"
            app:layout_flexGrow="1"
            app:shapeAppearance="?shapeAppearanceCornerLarge">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="left"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/grades_stats_yearly"
                    android:textAppearance="?textAppearanceBodyLarge"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/pointYearly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?textAppearanceTitleMedium"
                    tools:text="94,50%" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.flexbox.FlexboxLayout>

    <View
        android:id="@+id/pointDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/divider"
        android:visibility="gone" />

    <TextView
        android:id="@+id/universityTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:text="@string/grades_stats_university"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <LinearLayout
        android:id="@+id/universityLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grades_stats_this_semester" />

            <TextView
                android:id="@+id/universitySemester"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textSize="24sp"
                tools:text="4,56" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:background="@drawable/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grades_stats_all_grades" />

            <TextView
                android:id="@+id/universityTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textSize="24sp"
                tools:text="4,67" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:background="@drawable/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grades_stats_ects_points" />

            <TextView
                android:id="@+id/universityEcts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textSize="24sp"
                tools:text="120" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/universityDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/divider" />

    <TextView
        android:id="@+id/disclaimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/grades_stats_disclaimer"
        android:textAppearance="?textAppearanceBodySmall" />

    <View
        android:id="@+id/customValueDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="?colorOutline" />

    <LinearLayout
        android:id="@+id/customValueLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/grades_stats_custom_config_notice" />

        <Button
            android:id="@+id/customValueButton"
            style="?materialButtonSecondaryStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/configure" />
    </LinearLayout>
</LinearLayout>
